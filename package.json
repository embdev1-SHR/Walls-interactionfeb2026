{
  "name": "interactive-wall-games",
  "version": "1.0.0",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "voice:lines": "node scripts/voice-lines.mjs",
    "voice:bake": ".venv/Scripts/python.exe scripts/voice-bake.py",
    "photos": "node --env-file=.env.local scripts/fetch-pexels.mjs && npm run credits",
    "photos:list": "node scripts/fetch-pexels.mjs --list",
    "models": "node --env-file=.env.local scripts/fetch-sketchfab.mjs && npm run credits",
    "models:list": "node scripts/fetch-sketchfab.mjs --list",
    "credits": "node scripts/build-credits.mjs",
    "assets:review": "node scripts/build-asset-review.mjs --serve",
    "scenarios:review": "node scripts/build-scenario-review.mjs --serve"
  },
  "build": {
    "appId": "com.yourname.interactive-wall-games",
    "productName": "Auticare Blueroom Interactive",
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.icns"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.png"
    },
    "files": [
      "main.js",
      "login.html",
      "index.html",
      "intro.html",
      "FreeCanvas.html",
      "solar-system.html",
      "games/**/*",
      "js/**/*",
      "assets/**/*",
      "3dmodels/**/*",
      "node_modules/three/build/three.module.js",
      "node_modules/three/examples/jsm/loaders/GLTFLoader.js",
      "node_modules/three/examples/jsm/loaders/KTX2Loader.js",
      "node_modules/three/examples/jsm/libs/meshopt_decoder.module.js",
      "package.json"
    ],
    "directories": {
      "output": "release"
    }
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "three": "^0.182.0"
  }
}
